## Shortcuts

alias e=editor
alias pod="podman"

## Common typos

alias pgp=gpg
alias docker="podman"

## Default params

alias mc="mc --nosubshell"
alias less="/opt/homebrew/bin/less -S"

## Tools

# Outputs formatted json
alias pp.json="python3 -m json.tool"

# Trim new lines and copy to clipboard
alias c="tr -d '\n' | pbcopy"

# URL-encode strings
alias urlencode='python -c "import sys, urllib as ul; print ul.quote_plus(sys.argv[1]);"'
